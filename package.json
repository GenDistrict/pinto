{
  "name": "pinto-image-notes",
  "productName": "PINTO",
  "version": "0.3.0",
  "private": true,
  "description": "Point, note, copy. A locally editable desktop image instruction tool.",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "backup": "node scripts/manage.mjs backup",
    "changes": "node scripts/manage.mjs changes",
    "update:plan": "node scripts/manage.mjs update-plan",
    "update:apply": "node scripts/manage.mjs update-apply",
    "restore": "node scripts/manage.mjs restore",
    "format": "prettier --write src tests scripts/*.mjs scripts/lib/*.mjs *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GenDistrict/pinto.git"
  },
  "bugs": {
    "url": "https://github.com/GenDistrict/pinto/issues"
  },
  "homepage": "https://github.com/GenDistrict/pinto#readme"
}
